<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CardStyle">
        <item name="android:layout_marginStart">@dimen/card_marginStart</item>
        <item name="android:layout_marginEnd">@dimen/card_marginEnd</item>
        <item name="android:layout_marginTop">@dimen/card_marginTop</item>
        <item name="android:layout_marginBottom">@dimen/card_marginBottom</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="android:paddingHorizontal">28dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="Title">>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/title_medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="body">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">@dimen/body_medium</item>
    </style>

    <style name="TypeWithIconButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:layout_margin">0dp</item>

        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/content_inverse_selector</item>

        <item name="backgroundTint">@color/bg_inverse_selector</item>

        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/content_inverse_selector</item>
        <item name="iconSize">16dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">50dp</item>

        <item name="android:enabled">false</item>

        <item name="android:checkable">true</item>
        <item name="android:checked">false</item>
    </style>
    <style name="TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">0dp</item>
        <item name="android:layout_marginBottom">20dp</item>

        <item name="android:textSize">@dimen/body_medium</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>

        <item name="startIconTint">?attr/colorPrimary</item>

        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCollapsedPaddingTop">0dp</item>

        <item name="boxStrokeErrorColor">?attr/colorError</item>

        <item name="helperTextEnabled">false</item>
    </style>

    <style name="TextInputEditText" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">0dp</item>
        <item name="android:textSize">@dimen/body_medium</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:lines">1</item>
    </style>

    <style name="My.FilledButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">@dimen/title_medium</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="cornerRadius">8dp</item>
        <item name="rippleColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="My.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">@dimen/body_medium</item>
        <item name="android:textStyle">normal</item>
        <item name="rippleColor">@android:color/transparent</item>
        <item name="android:padding">0dp</item>
    </style>
    <style name="Widget.App.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">0dp</item>
        <item name="android:layout_marginBottom">20dp</item>

        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="startIconTint">?attr/colorPrimary</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>

        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item> <item name="boxCornerRadiusBottomEnd">12dp</item>

        <item name="endIconTint">?attr/colorPrimary</item>

        <item name="helperTextEnabled">false</item>
    </style>

    <style name="Widget.App.AutoCompleteTextView" parent="Widget.Material3.AutoCompleteTextView.FilledBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">12dp</item> <item name="android:paddingBottom">12dp</item>

        <item name="android:inputType">none</item>

        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>